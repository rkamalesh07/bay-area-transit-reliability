# Copy this file to .env and edit it. Never commit .env.
# BART's realtime feed needs no API key. These are just settings.

BART_TRIPUPDATES_URL=https://api.bart.gov/gtfsrt/tripupdate.aspx
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
RAW_DATA_DIR=data/raw

# Identify your collector to BART. Put a real contact so they can reach you.
USER_AGENT=bay-area-transit-reliability/0.1 (student project; contact: your-email@example.com)
